{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["env", "ingress", "config"],
  "properties": {
    "env": { "type": "string", "minLength": 1 },
    "ingress": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "required": ["AWS_REGION"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
